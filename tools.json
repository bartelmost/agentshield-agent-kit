[
 {
  "name": "agentshield_transfer",
  "description": "Check a bank transfer before money moves: IBAN, BIC, amount, SEPA scope, remittance text, name. Returns ok and failed fields.",
  "parameters": {
   "type": "object",
   "properties": {
    "iban": {
     "type": "string",
     "description": "Beneficiary IBAN"
    },
    "bic": {
     "type": "string",
     "description": "Optional BIC"
    },
    "amount": {
     "type": "string",
     "description": "Optional decimal amount"
    },
    "currency": {
     "type": "string",
     "description": "Optional currency code"
    },
    "reference": {
     "type": "string",
     "description": "Optional remittance text"
    },
    "name": {
     "type": "string",
     "description": "Optional beneficiary name"
    },
    "cid": {
     "type": "string",
     "description": "Optional German SEPA creditor id"
    }
   },
   "required": [
    "iban"
   ],
   "additionalProperties": false
  },
  "route_url": "https://agentshield.live/transfer"
 },
 {
  "name": "agentshield_invoice",
  "description": "Check an invoice before sending or paying: net + VAT = gross, VAT rate, IBAN, VAT id, date, number. Optional registry=1 asks EU VIES. Returns ok and failed fields.",
  "parameters": {
   "type": "object",
   "properties": {
    "net": {
     "type": "string",
     "description": "Net amount"
    },
    "vat": {
     "type": "string",
     "description": "VAT amount"
    },
    "gross": {
     "type": "string",
     "description": "Gross amount"
    },
    "rate": {
     "type": "string",
     "description": "Optional VAT percent"
    },
    "country": {
     "type": "string",
     "description": "Seller country code"
    },
    "currency": {
     "type": "string",
     "description": "Currency code"
    },
    "iban": {
     "type": "string",
     "description": "Optional IBAN"
    },
    "vatid": {
     "type": "string",
     "description": "Optional VAT id"
    },
    "date": {
     "type": "string",
     "description": "Optional YYYY-MM-DD"
    },
    "number": {
     "type": "string",
     "description": "Optional invoice number"
    },
    "registry": {
     "type": "string",
     "description": "Set to 1 to also ask EU VIES for the VAT id"
    }
   },
   "required": [
    "net",
    "gross"
   ],
   "additionalProperties": false
  },
  "route_url": "https://agentshield.live/invoice"
 },
 {
  "name": "agentshield_deadline",
