  "parameters": {
   "type": "object",
   "properties": {
    "date": {
     "type": "string",
     "description": "Start date YYYY-MM-DD, not counted"
    },
    "days": {
     "type": "string",
     "description": "Non-zero business-day count"
    },
    "country": {
     "type": "string",
     "description": "Two-letter country code"
    },
    "region": {
     "type": "string",
     "description": "Optional region such as BY"
    }
   },
   "required": [
    "date",
    "days",
    "country"
   ],
   "additionalProperties": false
  },
  "route_url": "https://agentshield.live/deadline"
 },
 {
